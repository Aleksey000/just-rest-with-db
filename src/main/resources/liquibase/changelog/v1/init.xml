<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-04-22-init-1" author="mr_element">
        <createTable tableName="just_data">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="data" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="modified_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="2026-04-22-init-2" author="mr_element">
        <createTable tableName="users">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(255)">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="password" type="VARCHAR(500)"/>
            <column name="role" type="VARCHAR(10)"/>
        </createTable>
    </changeSet>

    <changeSet id="2026-04-22-init-3" author="mr_element">
        <createTable tableName="projects">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
            </column>
        </createTable>
        <createTable tableName="project_member">
<!--            <column name="id" type="UUID">-->
<!--                <constraints primaryKey="true" nullable="false"/>-->
<!--            </column>-->
            <column name="user_id" type="UUID">
            </column>
            <column name="project_id" type="UUID"/>
        </createTable>
    </changeSet>

</databaseChangeLog>